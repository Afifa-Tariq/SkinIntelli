SECRET_KEY=
JWT_SECRET_KEY=
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/Skinintelli

# Gmail SMTP — MAIL_PASSWORD must be a Gmail App Password, NOT your account password.
# Enable 2FA on your Google account, then generate one at:
# https://myaccount.google.com/apppasswords
# Example app password format: abcd efgh ijkl mnop (16 chars, spaces optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=True
# Keep provider API keys in backend/.env, never in the Flutter app.
GEMINI_API_KEY=
# Google Maps Platform key with Places API (New) and billing enabled.
GOOGLE_MAPS_API_KEY=